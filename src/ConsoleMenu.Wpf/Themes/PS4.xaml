<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="App.Background" Color="#003791"/>
    <SolidColorBrush x:Key="Header.Background" Color="#002566"/>
    <SolidColorBrush x:Key="Text.Primary" Color="#FFFFFF"/>

    <Style TargetType="Button">
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="Margin" Value="0,0,8,8"/>
        <Setter Property="Background" Value="#0050C8"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderBrush" Value="#0A3F99"/>
    </Style>
</ResourceDictionary>
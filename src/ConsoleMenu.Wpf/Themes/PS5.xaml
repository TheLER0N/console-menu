<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="App.Background" Color="#10131A"/>
    <SolidColorBrush x:Key="Header.Background" Color="#1B2130"/>
    <SolidColorBrush x:Key="Text.Primary" Color="#F5F7FF"/>

    <Style TargetType="Button">
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="Margin" Value="0,0,8,8"/>
        <Setter Property="Background" Value="#2D3648"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderBrush" Value="#4A5568"/>
    </Style>
</ResourceDictionary>
<Window x:Class="ConsoleMenu.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Console Menu"
        Height="720" Width="1280"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource App.Background}">
    <DockPanel>
        <Border DockPanel.Dock="Top" Padding="16" Background="{DynamicResource Header.Background}">
            <DockPanel>
                <TextBlock Text="CONSOLE MENU"
                           FontSize="28"
                           Foreground="{DynamicResource Text.Primary}"
                           VerticalAlignment="Center"/>

                <ComboBox x:Name="ThemeCombo"
                          Width="120"
                          HorizontalAlignment="Right"
                          SelectionChanged="ThemeCombo_SelectionChanged">
                    <ComboBoxItem Content="PS5" Tag="ps5"/>
                    <ComboBoxItem Content="PS4" Tag="ps4"/>
                </ComboBox>
            </DockPanel>
        </Border>

        <TabControl Background="Transparent" Foreground="{DynamicResource Text.Primary}">
            <TabItem Header="Игры">
                <DockPanel Margin="12">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                        <Button x:Name="AddGameButton"
                                Content="Добавить .exe"
                                Width="140"
                                Margin="0,0,8,0"
                                Click="AddGameButton_Click"/>

                        <Button x:Name="LaunchGameButton"
                                Content="Запустить"
                                Width="140"
                                Click="LaunchGameButton_Click"/>
                    </StackPanel>

                    <ListBox x:Name="GamesList"
                             DisplayMemberPath="Title"
                             Background="Transparent"
                             Foreground="{DynamicResource Text.Primary}"/>
                </DockPanel>
            </TabItem>

            <TabItem Header="Магазин">
                <DockPanel Margin="12">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                        <ComboBox x:Name="StoreRepoCombo"
                                  Width="320"
                                  Margin="0,0,8,0"/>

                        <Button Content="Открыть страницу"
                                Width="160"
                                Click="OpenStorePage_Click"/>
                    </StackPanel>

                    <wv2:WebView2 x:Name="StoreWebView"/>
                </DockPanel>
            </TabItem>

            <TabItem Header="Настройки">
                <StackPanel Margin="12" MaxWidth="700" HorizontalAlignment="Left">
                    <CheckBox x:Name="EnableBoostCheck"
                              Content="Включить безопасный буст"
                              Foreground="{DynamicResource Text.Primary}"
                              Margin="0,0,0,8"/>

                    <TextBlock Text="GitHub token (опционально)"
                               Foreground="{DynamicResource Text.Primary}"/>

                    <TextBox x:Name="GitHubTokenBox" Margin="0,4,0,12"/>

                    <Button Content="Сохранить настройки"
                            Width="180"
                            Click="SaveSettings_Click"/>
                </StackPanel>
            </TabItem>

            <TabItem Header="Профили">
                <DockPanel Margin="12">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBox x:Name="ProfileNameBox" Width="220" Margin="0,0,8,0"/>
                        <Button Content="Добавить профиль" Width="150" Click="AddProfile_Click"/>
                    </StackPanel>

                    <ListBox x:Name="ProfilesList"
                             DisplayMemberPath="Name"
                             Background="Transparent"
                             Foreground="{DynamicResource Text.Primary}"/>
                </DockPanel>
            </TabItem>

            <TabItem Header="Медиа">
                <TextBlock Text="Медиа: обложки и скриншоты будут здесь."
                           Foreground="{DynamicResource Text.Primary}"
                           Margin="12"/>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
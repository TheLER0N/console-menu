<Window x:Class="ConsoleMenu.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Console Menu"
        Height="760" Width="1280"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResize">
    <Window.Resources>
        <Style x:Key="TileItemStyle" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent"
                                CornerRadius="{DynamicResource Tile.CornerRadius}" Padding="4">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Tile.Selected}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource App.Background}"
            CornerRadius="{DynamicResource Window.CornerRadius}"
            BorderBrush="#33FFFFFF" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="56"/>
                <RowDefinition Height="150"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" x:Name="TitleBar" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="24,0,12,0">
                    <TextBlock Text="{DynamicResource Brand.Text}"
                               FontSize="22" FontWeight="SemiBold"
                               Foreground="{DynamicResource Text.Primary}"
                               VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock x:Name="ProfileNameText"
                                   Foreground="{DynamicResource Text.Secondary}"
                                   VerticalAlignment="Center" Margin="0,0,16,0"/>
                        <TextBlock x:Name="ClockText" FontSize="18"
                                   Foreground="{DynamicResource Text.Primary}"
                                   VerticalAlignment="Center" Margin="0,0,16,0"/>
                        <Button Content="-" Width="40" Background="Transparent" BorderThickness="0"
                                Foreground="{DynamicResource Text.Primary}" Click="Minimize_Click"/>
                        <Button Content="X" Width="40" Background="Transparent" BorderThickness="0"
                                Foreground="{DynamicResource Text.Primary}" Click="Close_Click"/>
                    </StackPanel>
                </Grid>
            </Grid>

            <ListBox x:Name="NavList" Grid.Row="1" Margin="24,0"
                     VerticalAlignment="Center"
                     Background="Transparent" BorderThickness="0"
                     ItemContainerStyle="{StaticResource TileItemStyle}"
                     SelectionChanged="NavList_SelectionChanged">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Width="128" Margin="6,0">
                            <Border Height="86"
                                    CornerRadius="{DynamicResource Tile.CornerRadius}"
                                    Background="{DynamicResource Tile.Background}">
                                <TextBlock Text="{Binding Glyph}"
                                           FontFamily="Segoe MDL2 Assets" FontSize="34"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{DynamicResource Text.Primary}"/>
                            </Border>
                            <TextBlock Text="{Binding Label}" HorizontalAlignment="Center"
                                       Margin="0,8,0,0" FontSize="14"
                                       Foreground="{DynamicResource Text.Primary}"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Grid Grid.Row="2" Margin="24,0,24,24">
                <Grid x:Name="GamesPanel">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="44"/>
                    </Grid.RowDefinitions>
                    <ListBox x:Name="GamesList" Background="Transparent" BorderThickness="0"
                             ItemContainerStyle="{StaticResource TileItemStyle}">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Width="168" Margin="6">
                                    <Border Height="96"
                                            CornerRadius="{DynamicResource Tile.CornerRadius}"
                                            Background="{DynamicResource Tile.Background}">
                                        <TextBlock Text="{Binding Title}" TextWrapping="Wrap"
                                                   TextAlignment="Center" VerticalAlignment="Center"
                                                   Margin="10"
                                                   Foreground="{DynamicResource Text.Primary}"/>
                                    </Border>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel Grid.Row="1" Orientation="Horizontal">
                        <Button Content="Добавить .exe" Click="AddGameButton_Click"/>
                        <Button Content="Запустить" Click="LaunchGameButton_Click"/>
                        <Button Content="Убрать" Click="RemoveGameButton_Click"/>
                    </StackPanel>
                </Grid>

                <Grid x:Name="StorePanel" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="360"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <ComboBox x:Name="StoreRepoCombo"/>
                        <Button Content="Обновить релизы" Click="RefreshReleases_Click" HorizontalAlignment="Left"/>
                        <ListBox x:Name="ReleasesList" DisplayMemberPath="TagName"
                                 Height="180" Margin="0,10,0,10"
                                 ItemContainerStyle="{StaticResource TileItemStyle}"/>
                        <Button Content="Установить релиз" Click="InstallRelease_Click" HorizontalAlignment="Left"/>
                        <TextBlock x:Name="StoreStatus" Text="" TextWrapping="Wrap"
                                   Foreground="{DynamicResource Text.Secondary}" Margin="0,10,0,0"/>
                    </StackPanel>
                    <Grid Grid.Column="1">
                        <wv2:WebView2 x:Name="StoreWebView"/>
                        <Border x:Name="StoreFallback" Visibility="Collapsed"
                                CornerRadius="{DynamicResource Tile.CornerRadius}"
                                Background="{DynamicResource Tile.Background}">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="WebView2 недоступен" FontSize="20"
                                           Foreground="{DynamicResource Text.Primary}"
                                           HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                <TextBlock Text="Страницу магазина можно открыть в браузере."
                                           Foreground="{DynamicResource Text.Secondary}"
                                           HorizontalAlignment="Center" Margin="0,0,0,12"/>
                                <Button Content="Открыть в браузере" Click="OpenPageBrowser_Click"
                                        HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>

                <StackPanel x:Name="SettingsPanel" Visibility="Collapsed"
                            MaxWidth="560" HorizontalAlignment="Left">
                    <TextBlock Text="Оболочка" FontSize="18"
                               Foreground="{DynamicResource Text.Primary}" Margin="0,0,0,8"/>
                    <ComboBox x:Name="ThemeCombo" SelectionChanged="ThemeCombo_SelectionChanged">
                        <ComboBoxItem Content="PS5" Tag="ps5"/>
                        <ComboBoxItem Content="PS4" Tag="ps4"/>
                    </ComboBox>
                    <CheckBox x:Name="EnableBoostCheck" Content="Безопасный буст при запуске"/>
                    <TextBlock Text="GitHub token (опционально)"
                               Foreground="{DynamicResource Text.Secondary}" Margin="0,6,0,4"/>
                    <TextBox x:Name="GitHubTokenBox"/>
                    <Button Content="Сохранить настройки" Click="SaveSettings_Click" HorizontalAlignment="Left"/>
                </StackPanel>

                <DockPanel x:Name="ProfilesPanel" Visibility="Collapsed">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBox x:Name="ProfileNameBox" Width="240" Margin="0,0,10,0"/>
                        <Button Content="Добавить профиль" Click="AddProfile_Click"/>
                    </StackPanel>
                    <ListBox x:Name="ProfilesList" DisplayMemberPath="Name"
                             ItemContainerStyle="{StaticResource TileItemStyle}"/>
                </DockPanel>

                <StackPanel x:Name="MediaPanel" Visibility="Collapsed">
                    <TextBlock Text="Медиа" FontSize="18"
                               Foreground="{DynamicResource Text.Primary}" Margin="0,0,0,8"/>
                    <TextBlock Text="Обложки и скриншоты появятся здесь (data\media)."
                               Foreground="{DynamicResource Text.Secondary}"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>